# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Provider (anthropic | openai)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Price IDs
STRIPE_STUDENT_MONTHLY_PRICE_ID=price_...
STRIPE_STUDENT_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# App URL
NEXT_PUBLIC_APP_URL=https://promptops-kappa.vercel.app

# Email (optional — for digest notifications)
EMAIL_FROM=noreply@promptops.app
RESEND_API_KEY=re_...


# PromptOps LLM-first composer: choose exactly one explicitly configured provider.
# No automatic provider/model fallback. Never put provider secrets in NEXT_PUBLIC_*.
# PROMPTOPS_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_REASONING=<an actually installed model>
# Optional Groq, only after owner verifies this account's current no-spend eligibility:
# PROMPTOPS_LLM_PROVIDER=groq
# GROQ_API_KEY=<server-side existing key; never paste into Studio>
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_NO_SPEND_CONFIRMED=true
# This acknowledgement is NOT a spending cap. Do not enable for a billable account.
